# ============================================
# Blue Team Assistant - .gitignore
# ============================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# --- Virtual Environments ---
venv/
.venv/
env/
.env/

# --- Sensitive Configuration ---
config.yaml
!config.yaml.example
.env
.env.*
*.key
*.pem
*.p12
*.pfx

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Session / Analysis Data ---
session_data.json
ioc_result.json
ioc_session.json
ps.json

# --- Uploaded / Temp Files ---
uploads/
temp/
tmp/
*.tmp
nul

# --- Test Artifacts ---
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/
.tox/
.nox/
docs/test_report.xlsx
scripts/reporting/_junit_results.xml

# --- Local Settings ---
.claude/

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- Data files that may contain analysis results ---
data/analyses/
data/reports/
data/uploads/
data/cases/
data/sessions/

# --- Node (if MCP servers use npm) ---
node_modules/
package-lock.json

# --- Docker ---
docker-compose.override.yml

# Debug/scratch scripts
tools/debug_scripts/*.pyc
*.tmp.py
temp_*.py

# --- Miscellaneous ---
scripts/adhoc/
# Keep repeatable evaluation tooling and its rationale trackable separately.
!scripts/eval/
!scripts/eval/**
data/simulated_actions/
output.html
fix_incident_response_playbook.py

data/tickets/*.db

*.snapshot.json
poll_snapshot*.json

*.db
data/tickets/tickets.db
agent_store.db
data/agent_store.db

pixel-office.zip

hermes-plugins-reference/
data/benchmark/
scripts/eval/__pycache__/
*.pyc
*.bak
evidence_raw/
test_keys/

evidence
evidence/source_weights_2026-09-16
!.env.example
