# Copy this file to ".env" (same folder) and fill in real values.
# Never commit the real .env file to git.

# =========================================================
# REQUIRED — app will crash / fail to start without these
# =========================================================
AUTH_JWT_SECRET=

# =========================================================
# GMAIL_TOKEN_ENCRYPTION_KEY — required ONLY if using the Gmail
# link/notification feature (encrypts stored OAuth tokens).
# Not needed just to log in / use the dashboard normally.
# Generate the same way as AUTH_JWT_SECRET:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =========================================================
# GMAIL_TOKEN_ENCRYPTION_KEY=

# =========================================================
# LLM_DGA_VLLM_CANARY_PERCENT — optional, controls % rollout
# of the DGA-judge canary. Leave unset to use the code default.
# =========================================================
# LLM_DGA_VLLM_CANARY_PERCENT=

# =========================================================
# OPTIONAL — config / db paths (have defaults in code)
# =========================================================
# BTA_CONFIG=
# TICKETING_DB_PATH=data/tickets/tickets.db
# check src/web/auth.py -> value of AUTH_DB_ENV, default src/db/auth.db
# <AUTH_DB_ENV_REAL_NAME>=

# =========================================================
# OPTIONAL — auth/security tuning
# =========================================================
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_WINDOW_SECONDS=900
# AUTH_COOKIE_SECURE=0

# =========================================================
# OPTIONAL — threat-intel API keys (Group B sources)
# =========================================================
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# SHODAN_API_KEY=
# ALIENVAULT_API_KEY=
# GREYNOISE_API_KEY=
# CENSYS_API_KEY=
# PULSEDIVE_API_KEY=
# CRIMINALIP_API_KEY=
# IPQS_API_KEY=
# PHISHTANK_API_KEY=
# HYBRID_API_KEY=
# ANYRUN_API_KEY=
# TRIAGE_API_KEY=
# THREATZONE_API_KEY=
# JOESANDBOX_API_KEY=
# IP2PROXY_API_KEY=
# ANTHROPIC_API_KEY=

# =========================================================
# OPTIONAL — sandbox / external tools
# =========================================================
# GHIDRA_HOME=
# MOBSF_URL=http://localhost:8000
# MOBSF_API_KEY=

# =========================================================
# OPTIONAL — misc
# =========================================================
# LOG_FORMAT=text
